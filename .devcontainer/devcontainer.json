{
    "name": "Python 3",
    // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
    "customizations": {
      "codespaces": {
        "openFiles": [
          "start.py"
        ]
      },
      "vscode": {
        "settings": {},
        "extensions": [
          "ms-python.pylint",
          "ms-python.python",
          "ms-python.vscode-pylance",
          "aaron-bond.better-comments",
          "vscode-icons-team.vscode-icons",
          "ms-python.autopep8"
        ]
      }
    },
    "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; pip3 install --upgrade pip; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; pip3 install --user streamlit; echo '✅ Packages installed and Requirements met'",
    "postAttachCommand": {
      "server": "streamlit run start.py"
    },
    "portsAttributes": {
      "8501": {
        "label": "Application",
        "onAutoForward": "openPreview"
      }
    },
    "forwardPorts": [
      8501
    ]
  }